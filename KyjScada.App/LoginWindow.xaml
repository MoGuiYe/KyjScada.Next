<Window x:Class="KyjScada.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录" Height="272" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#181825">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="KyjScada 登录" Foreground="#FFFFFF"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="用户名" Foreground="#C6CDE0" Width="70" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="UserBox" Width="240" Height="34" FontSize="13"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="8,6" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="密  码" Foreground="#C6CDE0" Width="70" VerticalAlignment="Center" FontSize="13"/>
            <PasswordBox x:Name="PassBox" Width="240" Height="34" FontSize="13"
                         Background="#11111B" Foreground="#FFFFFF"
                         BorderBrush="#45475A" BorderThickness="1" Padding="8,6" VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Text="" Foreground="#F38BA8"
                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="4" x:Name="HintText" Text="" Foreground="#8C93AB"
                   FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="登录" Width="80" Height="28" Click="OnLogin"
                    IsDefault="True"
                    Background="#2A3A2A" Foreground="#FFFFFF"
                    BorderBrush="#45475A" BorderThickness="1"/>
            <Button Content="取消" Width="80" Height="28" Margin="10,0,0,0" Click="OnCancel"
                    IsCancel="True"
                    Background="#313244" Foreground="#FFFFFF"
                    BorderBrush="#45475A" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
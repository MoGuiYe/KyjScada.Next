<Window x:Class="KyjScada.App.UserManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户管理" Height="620" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#181825">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左:用户列表 -->
            <Border Grid.Column="0" Background="#1E1E2E" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="账号列表" Foreground="#FFFFFF"
                               FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="1" x:Name="UserGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="#181825" RowBackground="#1E1E2E"
                              AlternatingRowBackground="#181825" Foreground="#FFFFFF"
                              BorderThickness="0" FontSize="12"
                              SelectionChanged="OnUserSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="权限" Binding="{Binding PermissionText}" Width="*"/>
                            <DataGridTextColumn Header="启用" Binding="{Binding ActiveText}" Width="60"/>
                            <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右:编辑区 -->
            <Border Grid.Column="1" Background="#1E1E2E" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="账号编辑" Foreground="#FFFFFF" FontSize="12"
                                   FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="用户名" Foreground="#C6CDE0" Width="70"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="NameBox" Width="200" Height="24"
                                     Background="#11111B" Foreground="#FFFFFF"
                                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="密码" Foreground="#C6CDE0" Width="70"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <PasswordBox x:Name="PassBox" Width="200" Height="24"
                                         Background="#11111B" Foreground="#FFFFFF"
                                         BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
                        </StackPanel>

                        <CheckBox x:Name="ActiveBox" Content="启用该账号" IsChecked="True"
                                  Foreground="#C6CDE0" FontSize="12" Margin="0,4,0,8"/>

                        <TextBlock Text="权限" Foreground="#C6CDE0" FontSize="12" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="PermPanel" Orientation="Horizontal" Width="360"/>

                        <TextBlock x:Name="ResultText" Text="" Foreground="#F9E2AF"
                                   FontSize="12" Margin="0,10,0,10" TextWrapping="Wrap"/>

                        <Button Content="新建(清空表单)" Width="130" Height="28" Margin="0,4,0,0"
                                HorizontalAlignment="Left" Click="OnNewUser"
                                Background="#2A3A2A" Foreground="#FFFFFF"
                                BorderBrush="#45475A" BorderThickness="1"/>
                        <Button Content="保存 / 创建" Width="130" Height="28" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="OnSavePermissions"
                                Background="#313244" Foreground="#FFFFFF"
                                BorderBrush="#45475A" BorderThickness="1"/>
                        <Button Content="重置密码" Width="110" Height="28" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="OnResetPassword"
                                Background="#313244" Foreground="#FFFFFF"
                                BorderBrush="#45475A" BorderThickness="1"/>
                        <Button Content="删除用户" Width="110" Height="28" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="OnDelete"
                                Background="#4B2A2A" Foreground="#FCA5A5"
                                BorderBrush="#45475A" BorderThickness="1"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#1E1E2E" Padding="8" Margin="0,8,0,0">
            <TextBlock x:Name="HintText" Text="" Foreground="#8C93AB"
                       FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="关闭" Width="90" Height="28" Click="OnClose"
                    IsCancel="True"
                    Background="#313244" Foreground="#FFFFFF"
                    BorderBrush="#45475A" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
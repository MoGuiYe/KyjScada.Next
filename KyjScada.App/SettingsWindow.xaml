<Window x:Class="KyjScada.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#181825">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="归档与写入参数" Foreground="#FFFFFF"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="归档周期(秒)" Foreground="#C6CDE0" Width="130"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="IntervalBox" Width="120" Height="24"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
            <TextBlock Text="越小越细,越费磁盘" Foreground="#8C93AB"
                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="历史保留(天)" Foreground="#C6CDE0" Width="130"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="RetentionBox" Width="120" Height="24"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
            <TextBlock Text="0 = 永久保留" Foreground="#8C93AB"
                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Text="写入最小间隔(ms)" Foreground="#C6CDE0" Width="130"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="WriteIntervalBox" Width="120" Height="24"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
            <TextBlock Text="防连点" Foreground="#8C93AB"
                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="班次小时 / 早班起点" Foreground="#C6CDE0" Width="130"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="ShiftHoursBox" Width="60" Height="24"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
            <TextBox x:Name="ShiftStartBox" Width="60" Height="24" Margin="8,0,0,0"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
            <TextBlock Text="小时 / 0-23 点" Foreground="#8C93AB"
                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="默认报警死区" Foreground="#C6CDE0" Width="130"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="DeadbandBox" Width="120" Height="24"
                     Background="#11111B" Foreground="#FFFFFF"
                     BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
            <TextBlock Text="变量没配时用它;0=不启用" Foreground="#8C93AB"
                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- ==================== MCP 服务 ==================== -->
        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <Border Height="1" Background="#313244" Margin="0,0,0,12"/>

            <TextBlock Text="MCP 服务(供外部 AI 客户端读数据,并在授权下写值)"
                       Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="McpEnabledBox" Content="启用" Width="130"
                          Foreground="#C6CDE0" FontSize="12" VerticalAlignment="Center"
                          Checked="OnMcpEnabledChanged" Unchecked="OnMcpEnabledChanged"/>
                <TextBlock Text="端口" Foreground="#C6CDE0" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="McpPortBox" Width="90" Height="24"
                         Background="#11111B" Foreground="#FFFFFF"
                         BorderBrush="#45475A" BorderThickness="1" Padding="4,2"/>
                <TextBlock Text="1024-65535,只监听本机" Foreground="#8C93AB"
                           Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="当前状态" Foreground="#C6CDE0" Width="130"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="McpStatusText" Foreground="#A6E3A1" FontSize="12"
                           VerticalAlignment="Center" Text="读取中…" TextWrapping="Wrap"
                           MaxWidth="250"/>
                <Button x:Name="CopyEndpointBtn" Content="复制端点" Width="80" Height="24"
                        Margin="10,0,0,0" Click="OnCopyEndpoint"
                        Background="#313244" Foreground="#FFFFFF"
                        BorderBrush="#45475A" BorderThickness="1"/>
            </StackPanel>

            <TextBlock x:Name="McpHintText" Foreground="#8C93AB" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="7" x:Name="ResultText" Text="" Foreground="#F9E2AF"
                   FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="80" Height="28" Click="OnSave"
                    Background="#2A3A2A" Foreground="#FFFFFF"
                    BorderBrush="#45475A" BorderThickness="1"/>
            <Button Content="关闭" Width="80" Height="28" Margin="10,0,0,0" Click="OnClose"
                    IsCancel="True"
                    Background="#313244" Foreground="#FFFFFF"
                    BorderBrush="#45475A" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>